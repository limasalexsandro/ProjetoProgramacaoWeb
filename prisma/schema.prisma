// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Professor {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  bancos    BancoQuestao[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Turma {
  id         Int      @id @default(autoincrement())
  nome       String
  codigo     String   @unique
  semestre   String

  createdAt  DateTime @default(now())
  
  avaliacoes  Avaliacao[]
  alunos      Aluno[]

}


model Aluno {
  id        Int      @id @default(autoincrement())
  nome      String
  matricula String   @unique
  email     String?

  turmaId   Int
  turma     Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Avaliacao {
  id          Int      @id @default(autoincrement())
  titulo      String
  descricao   String?
  data         DateTime

  turmaId     Int
  turma       Turma    @relation(fields: [turmaId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum QuestaoTipo {
  DISCURSIVA
  MULTIPLA_ESCOLHA
}

model BancoQuestao {
  id          Int        @id @default(autoincrement())
  nome        String
  descricao   String?
  professor   Professor  @relation(fields: [professorId], references: [id])
  professorId Int
  questoes    Questao[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Questao {
  id        Int          @id @default(autoincrement())
  banco     BancoQuestao @relation(fields: [bancoId], references: [id])
  bancoId   Int
  tipo      QuestaoTipo
  enunciado String
  peso      Int
  gabarito  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

